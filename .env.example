# Puertos publicados en el equipo
BACKEND_PORT=3000
FRONTEND_PORT=8080

# URL con la que el NAVEGADOR llega al API (se incrusta al compilar el frontend)
VITE_API_BASE_URL=http://localhost:3000/api/v1
# URL pública del API (enlaces de archivos subidos)
API_BASE_URL=http://localhost:3000

JWT_TOKEN=cambiar_por_una_cadena_larga_y_aleatoria
JWT_TOKEN_EXPIRATION=8h
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@knomidoc.com
ADMIN_PASSWORD=Cambiar2026*
