# ───────── Servidor ─────────
NODE_ENV=development
PORT=3000
# URL pública del API (se usa para armar los enlaces de archivos subidos)
API_BASE_URL=http://localhost:3000

# ───────── Base de datos (PostgreSQL) ─────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambiar_esta_clave
DB_NAME=knomidoc
# true = TypeORM crea/ajusta tablas al iniciar (desarrollo). En producción estable: false
DB_SYNCHRONIZE=true

# ───────── Seguridad (JWT) ─────────
# Cadena larga y aleatoria. Ej.: openssl rand -hex 48
JWT_TOKEN=cambiar_por_una_cadena_larga_y_aleatoria
JWT_TOKEN_EXPIRATION=8h

# ───────── Usuario administrador inicial ─────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@knomidoc.com
ADMIN_PASSWORD=Cambiar2026*
# Clave inicial de los usuarios creados sin contraseña
DEFAULT_PASSWORD=Knomi2026*

# ───────── Verificación de correo ─────────
# false = no exige confirmar el correo con código (útil en pruebas sin SMTP)
EMAIL_VERIFICACION_OBLIGATORIA=true
CODIGO_EXPIRA_MINUTOS=10

# ───────── Correo saliente (SMTP). Sin MAIL_HOST el código se muestra en el log (solo desarrollo) ─────────
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="KnomiDoc" <no-reply@knomidoc.com>

# ───────── Datos de la entidad (membrete de PDF: actas, notas, reportes) ─────────
ENTIDAD_NOMBRE=GOBIERNO AUTÓNOMO MUNICIPAL DE SAN LUCAS
ENTIDAD_SIGLA=GAMSL
ENTIDAD_CIUDAD=San Lucas
ENTIDAD_UNIDAD=UNIDAD DE ARCHIVO
# Prefijo de los CITE: GAMSL/ARCH/AE-N° 004/2026, GAMSL/ARCH/AUD/OF-N° 004/2026
CITE_PREFIJO=GAMSL/ARCH

# ───────── Escaneos C31 (carpeta privada, no se sirve estáticamente) ─────────
C31_STORAGE_DIR=./storage/c31
CITES_STORAGE_DIR=./storage/cites
